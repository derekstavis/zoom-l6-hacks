+/* Recompute the selected period and pause/resume on a stopped input. */
+static void systick_update_selected_clock(SysTickState *s)
+{
+    Clock *selected = (s->control & SYSTICK_CLKSOURCE) ? s->cpuclk : s->refclk;
+    bool running = (s->control & SYSTICK_ENABLE) && clock_get(selected);
+
+    if (!running) {
+        ptimer_stop(s->ptimer);
+    }
+    systick_set_period_from_clock(s);
+    if (running) {
+        ptimer_run(s->ptimer, 0);
+    }
+}
+
 static void systick_timer_tick(void *opaque)
 {
     SysTickState *s = (SysTickState *)opaque;
@@ -149,17 +164,9 @@
